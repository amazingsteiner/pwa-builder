{
  "appName": "Learnly",
  "appId": "com.elites.learnly",
  "appDescription": "Learnly — Learn and Grow",
  "version": "1.0.0",
  "backgroundColor": "#ffffff",
  "themeColor": "#4CAF50",
  "sourceIcon": "source-icon.png",
  "android": {
    "minSdkVersion": 22,
    "targetSdkVersion": 34,
    "compileSdkVersion": 34,
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "camera": {
      "enabled": false,
      "permissions": ["camera", "photos"]
    },
    "notifications": {
      "enabled": false,
      "smallIcon": "ic_stat_notification",
      "iconColor": "#4CAF50",
      "sound": "notification_sound.wav"
    }
  },
  "webDir": "www",
  "filesToCopy": [
    "index.html",
    "app.js",
    "styles.css",
    "manifest.webmanifest",
    "sw.js"
  ],
  "foldersToCopy": [
    "assets",
    "content",
    "icons"
  ]
}
